# O front consome a API por caminho relativo (/api) via proxy do Vite em dev.
# Para apontar para uma API externa em produção, defina:
# VITE_API_URL="https://api.suacampanha.com.br/api"
VITE_API_URL=

# Google Maps JS API — quando setada, a página /mapa usa Google Maps.
# Sem a chave, o mapa usa fallback CartoDB Voyager (Leaflet, gratuito).
# Precisa ter a API "Maps JavaScript" ativada no console Google Cloud e
# restringir por HTTP referrer (URL de produção + preview) por segurança.
# VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
VITE_GOOGLE_MAPS_API_KEY=
