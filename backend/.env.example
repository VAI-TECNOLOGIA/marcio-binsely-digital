# ==========================================================
# Márcio Binsely Digital — Backend (.env)
# Copie para .env e ajuste conforme o ambiente.
# ==========================================================

# ----- Banco de dados (PostgreSQL) -----
# IMPORTANTE: usamos o prefixo APP_ para evitar colisão com integrações da Vercel
# (Neon/Supabase auto-injetam DATABASE_URL). schema.prisma SEMPRE lê APP_DATABASE_URL
# e APP_DIRECT_URL. Em dev, env.js também aceita DATABASE_URL como fallback.
APP_DATABASE_URL="postgresql://mbd:mbd_secret@localhost:5432/marcio_binsely?schema=public"
APP_DIRECT_URL="postgresql://mbd:mbd_secret@localhost:5432/marcio_binsely?schema=public"

# ----- Servidor -----
PORT=4000
NODE_ENV=development

# ----- Autenticação JWT -----
# OBRIGATÓRIO em produção. Gere um segredo forte com:  openssl rand -base64 48
JWT_SECRET="troque-este-segredo-em-producao-marcio-binsely-2026"
JWT_EXPIRES_IN="7d"
JWT_RESET_EXPIRES_IN="1h"

# ----- CORS — origem do front-end -----
CORS_ORIGIN="http://localhost:5173"

# ----- Upload de arquivos -----
# 'local' = só funciona em dev (salva em ./uploads).
# EM PRODUÇÃO use 's3' (ou Vercel Blob) — arquivos locais NÃO PERSISTEM em serverless.
UPLOAD_DRIVER="local"
UPLOAD_DIR="uploads"
PUBLIC_URL="http://localhost:4000"

# S3 compatível (AWS / Vercel Blob / MinIO / Backblaze) — usado com UPLOAD_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="marcio-binsely"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ==========================================================
# Integrações futuras (arquitetura preparada — não conectadas)
# ==========================================================
# WhatsApp Cloud API (Oficial - Meta)
WHATSAPP_PROVIDER="simulado"        # simulado | meta_cloud
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="mbd-verify"

# Instagram / Messenger (Meta Graph API)
META_APP_ID=""
META_APP_SECRET=""

# SMS (provedor genérico)
SMS_PROVIDER="simulado"
SMS_API_KEY=""

# E-mail transacional (reset de senha). Ativa sozinho quando RESEND_API_KEY existir.
# EMAIL_PROVIDER força o modo: resend | simulado (log no console)
EMAIL_PROVIDER=""
RESEND_API_KEY=""
EMAIL_FROM="Márcio Binsely Digital <nao-responda@seudominio.com.br>"
